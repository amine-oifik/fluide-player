<resources>
    <!-- Playlists screen: shift of the programme guide of one playlist. -->
    <string name="data_epg_offset">Décalage du guide</string>
    <string name="data_epg_offset_hint">Avance ou retarde les horaires du guide de cette playlist (par pas de 30 min)</string>
    <string name="data_epg_offset_none">Aucun</string>
    <!-- %1$s: sign (+ or −), %2$d: hours. Example: +2 h -->
    <string name="data_epg_offset_hours">%1$s%2$d h</string>
    <!-- %1$s: sign (+ or −), %2$d: hours, %3$02d: minutes. Example: +1 h 30 -->
    <string name="data_epg_offset_hours_minutes">%1$s%2$d h %3$02d</string>
    <!-- %1$s: sign (+ or −), %2$d: minutes. Example: −30 min -->
    <string name="data_epg_offset_minutes">%1$s%2$d min</string>
    <string name="data_epg_offset_earlier">Avancer le guide de 30 minutes</string>
    <string name="data_epg_offset_later">Retarder le guide de 30 minutes</string>

