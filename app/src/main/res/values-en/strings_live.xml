<?xml version="1.0" encoding="utf-8"?>
<!-- English translation of values/strings_live.xml (Live TV, programme guide and player overlays). -->
<resources>
    <plurals name="live_channel_count">
        <item quantity="one">%1$d channel</item>
        <item quantity="other">%1$d channels</item>
    </plurals>

    <string name="live_group_all">All</string>

    <!-- Programme on air: time left ("23 min left", "1 h 05 left"). -->
    <string name="live_remaining">%1$s left</string>
    <!-- Programme to come: time before it starts ("In 45 min"). -->
    <string name="live_starts_in">In %1$s</string>
    <!-- Video player: time at which the video ends ("Ends at 22:41"). -->
    <string name="live_ends_at">Ends at %1$s</string>
    <string name="live_upcoming_badge">UPCOMING</string>

    <string name="live_epg_play_live">OK: watch live</string>
    <string name="live_epg_play_replay">OK: watch this program again</string>

    <string name="live_no_preview">No channel playing</string>
    <string name="live_no_preview_hint">Press OK on a channel to watch it here</string>

    <string name="live_controls_hint">◀ ▶: ±10 s   ·   OK: pause   ·   ▼: options</string>
    <string name="live_number_label">Channel</string>

    <string name="live_options_hint">OK: select   ·   Back: close</string>
    <string name="live_options_more">More options</string>
</resources>
