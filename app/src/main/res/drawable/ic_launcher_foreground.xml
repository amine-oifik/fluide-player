<?xml version="1.0" encoding="utf-8"?>
<!--
  108dp adaptive-icon layer (also used as the monochrome layer): the Fluide Player mark, a rounded play
  triangle filled with a flowing wave (blue upper part, cyan "liquid" lower part). The mark is designed in
  a 100 x 100 box (same geometry as FluideMark in ui/components/Brand.kt) and placed by the group inside
  the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.64"
        android:scaleY="0.64"
        android:translateX="22"
        android:translateY="22">
        <!-- Upper part -->
        <path android:pathData="M24,58 L24,20 Q24,10 32.69,14.96 L85.31,45.04 Q94,50 85.31,54.96 L80,58 C58,40 42,74 24,58 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="24"
                    android:startY="12"
                    android:endX="90"
                    android:endY="56"
                    android:startColor="#FF3D7BFF"
                    android:endColor="#FF2BB0F7" />
            </aapt:attr>
        </path>
        <!-- Lower part (the wave) -->
        <path android:pathData="M24,64.5 C42,80.5 57,46 76,60.29 L32.69,85.04 Q24,90 24,80 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="24"
                    android:startY="62"
                    android:endX="62"
                    android:endY="88"
                    android:startColor="#FF22D3EE"
                    android:endColor="#FF86F4FF" />
            </aapt:attr>
        </path>
    </group>
</vector>
